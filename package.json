{
  "name": "stemap",
  "version": "0.1.0",
  "description": "A map of your code that agents keep true: flows and modules, each sentence tied to the code it rests on",
  "keywords": [
    "documentation",
    "code-map",
    "architecture",
    "agents",
    "claude-code",
    "mcp",
    "call-graph",
    "typescript",
    "vue",
    "nuxt",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Ice-Hazymoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ice-Hazymoon/stemap.git"
  },
  "homepage": "https://github.com/Ice-Hazymoon/stemap#readme",
  "bugs": "https://github.com/Ice-Hazymoon/stemap/issues",
  "type": "module",
  "bin": {
    "stemap": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsdown",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "citty": "^0.2.2",
    "ink": "^8.0.0",
    "open": "^11.0.4",
    "oxc-parser": "^0.156.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.3",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
